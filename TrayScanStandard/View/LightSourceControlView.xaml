<Page x:Class="TrayScanStandard.View.LightSourceControlView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TrayScanStandard.View"
      xmlns:converters="clr-namespace:TrayScanStandard.Converters"
      xmlns:vm="clr-namespace:TrayScanStandard.ViewModel"
      mc:Ignorable="d" 
      d:DataContext="{d:DesignInstance Type=local:LightSourceControlView}"
      d:DesignHeight="550" d:DesignWidth="800"
      Title="光源控制界面">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ========== 连接设置区域 ========== -->
        <GroupBox Header="光源设置" Grid.Row="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="光源类型：" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding ViewModel.LightTypes}" 
                      SelectedItem="{Binding ViewModel.SelectedLightType}"
                      Grid.Row="0" Grid.Column="1" Margin="0,0,15,0"
                      Height="28" VerticalAlignment="Center"/>

                <Label Content="COM端口：" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding ViewModel.ComPorts}" 
                      SelectedItem="{Binding ViewModel.SelectedComPort}"
                      IsEditable="True"
                      Grid.Row="0" Grid.Column="3" Margin="0,0,10,0"
                      Height="28" VerticalAlignment="Center"/>

                <Button Content="刷新" Command="{Binding ViewModel.RefreshComPortsCommand}"
                                       Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                                       Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" 
                    Grid.Row="0" Grid.Column="4" Width="65"/>

                <Label Content="波特率：" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding ViewModel.BaudRates}" 
                          SelectedItem="{Binding ViewModel.SelectedBaudRate}"
                          Grid.Row="1" Grid.Column="1" Margin="0,10,15,0"
                          Height="28" VerticalAlignment="Center"/>

                <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="连接" Command="{Binding ViewModel.ConnectCommand}" 
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"  Width="70"/>
                    <Button Content="断开" Command="{Binding ViewModel.DisconnectCommand}" 
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"  Width="70" Margin="10,0,0,0"/>
                    <Button Content="保存配置" Command="{Binding ViewModel.SaveConfigCommand}" 
                            Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                            Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"  Width="80" Margin="20,0,0,0"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- ========== 多通道控制区域（4个通道横向排放） ========== -->
        <GroupBox Header="多通道光源控制" Grid.Row="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 通道1 -->
                <Border Grid.Column="0"  Margin="0,0,5,0">
                    <StackPanel>
                        <Border Background="#3498DB" CornerRadius="4" Height="20" Width="20" 
                                HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="1" FontSize="8" FontWeight="Bold" Foreground="White" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBox Text="{Binding ViewModel.Channel1Brightness, UpdateSourceTrigger = PropertyChanged}" 
                     TextAlignment="Center" Height="30" Width="80" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    </StackPanel>
                </Border>

                <!-- 通道2 -->
                <Border Grid.Column="1"  Margin="5,0,5,0">
                    <StackPanel>
                        <Border Background="#E74C3C" CornerRadius="4" Height="20" Width="20" 
                    HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="2" FontSize="8" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBox Text="{Binding ViewModel.Channel2Brightness, UpdateSourceTrigger = PropertyChanged}" 
                     TextAlignment="Center" Height="30" Width="80" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    </StackPanel>
                </Border>

                <!-- 通道3 -->
                <Border Grid.Column="2"  Margin="5,0,5,0">
                    <StackPanel>
                        <Border Background="#F39C12" CornerRadius="4" Height="20" Width="20" 
                    HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="3" FontSize="8" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBox Text="{Binding ViewModel.Channel3Brightness, UpdateSourceTrigger = PropertyChanged}" 
                    TextAlignment="Center" Height="30" Width="80" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    </StackPanel>
                </Border>

                <!-- 通道4 -->
                <Border Grid.Column="3"  Margin="5,0,0,0">
                    <StackPanel>
                        <Border Background="#9B59B6" CornerRadius="4" Height="20" Width="20" 
                    HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock Text="4" FontSize="8" FontWeight="Bold" Foreground="White" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <TextBox Text="{Binding ViewModel.Channel4Brightness, UpdateSourceTrigger = PropertyChanged}" 
                     TextAlignment="Center" Height="30" Width="80" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    </StackPanel>
                </Border>
            </Grid>
        </GroupBox>


        <!-- ========== 批量操作区域 ========== -->
        <GroupBox Header="批量操作" Grid.Row="2">
            <StackPanel>
                <WrapPanel Margin="0,0,0,8">
                    <!--<Button Content="全部开启" Width="80" Margin="0,0,10,0"
                        Command="{Binding ViewModel.TurnOnAllCommand}"/>
                    <Button Content="全部关闭" Width="80" Margin="0,0,10,0"
                        Command="{Binding ViewModel.TurnOffAllCommand}"/>-->
                    <Button Content="读取所有通道" Width="100" Margin="0,0,10,0"
                        Command="{Binding ViewModel.ReadAllChannelsCommand}" 
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" 
                        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />

                    <Button Content="读取版本号" Width="95"
                        Command="{Binding ViewModel.ReadVersionCommand}"
                        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                        Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                    <TextBlock Text="{Binding ViewModel.VersionInfo}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ViewModel.ReadStatus}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </WrapPanel>
            </StackPanel>
        </GroupBox>

        
    </Grid>
</Page>
