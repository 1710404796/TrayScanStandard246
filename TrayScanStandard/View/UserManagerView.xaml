<Page x:Class="TrayScanStandard.View.UserManagerView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:TrayScanStandard.View"
      xmlns:lang="clr-namespace:TrayScanStandard.Properties"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UserManagerView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
             BorderThickness="0,0,0,1" Padding="5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：管理操作 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Name="AddUser" Click="AddUser_Click" Margin="0,0,5,0">添加用户</Button>
                    <Button Name="DelUser" Click="DelUser_Click" Margin="0,0,5,0">删除用户</Button>
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,2"/>
                    <TextBlock VerticalAlignment="Center" Margin="5,0,3,0" Foreground="Black">导入角色：</TextBlock>

                    <ComboBox ItemsSource="{Binding ViewModel.RoleList}"
                           SelectedItem="{Binding ViewModel.SelectedRole, Mode=TwoWay}"
                           Width="110" Margin="0,0,5,0"
                           VerticalAlignment="Center"/>

                    <Button Content="导入" Margin="5,0,0,0" Command="{Binding ViewModel.ImportCsvCommand}"/>
                </StackPanel>

                <!-- 右侧：搜索 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,5,0"
                            Foreground="Black">用户名：</TextBlock>
                    <TextBox x:Name="UserInfo" Height="26" Width="120"
                          VerticalContentAlignment="Center"/>

                    <Button x:Name="Select" Width="60" Margin="5,0,0,0"
                         Content="{x:Static lang:Resources.Query}"
                         Click="Select_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 数据表格 -->
        <ScrollViewer Grid.Row="1" Loaded="ScrollViewer_Loaded" >
            <DataGrid 
                Name="ddShow"
                AutoGenerateColumns="False" 
                CanUserAddRows="False" 
                IsReadOnly="True"
                RowHeaderWidth="0"
                ColumnWidth="*" 
                ItemsSource="{Binding ViewModel.Users}"
                RowEditEnding="ddShow_RowEditEnding"
                LoadingRow="ddShow_LoadingRow"
                HeadersVisibility ="Column">   

                <DataGrid.Columns>
                    <DataGridTextColumn Header="{x:Static lang:Resources.Username}" Width="150"  Binding="{Binding LinxUser.UserName, UpdateSourceTrigger=PropertyChanged}"></DataGridTextColumn>
                    <DataGridTextColumn Header="{x:Static lang:Resources.Identity}" Width="150"  Binding="{Binding Role, UpdateSourceTrigger=PropertyChanged}"></DataGridTextColumn>
                    <DataGridTextColumn Header="RFID" IsReadOnly="True" Width="150"  Binding="{Binding PassStar}"></DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ScrollViewer>
    </Grid>
</Page>
